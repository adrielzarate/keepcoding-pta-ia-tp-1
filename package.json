{
  "name": "adriel-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && esbuild src/client/presentation.ts src/client/project.ts --bundle --format=esm --outdir=public --entry-names=[name]",
    "start": "node --env-file=.env dist/server.js",
    "admin:setup": "node --env-file=.env --import tsx scripts/admin.ts",
    "backup": "node --env-file=.env --import tsx scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint 'public/**/*.css'",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:pbt": "vitest run tests/pbt",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "security:install": "node scripts/install-opengrep.mjs",
    "security": "node scripts/security.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm security",
    "env:init": "node scripts/setup.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ejs": "6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
