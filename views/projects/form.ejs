<%- include('../partials/head', { title: 'New project — Portfolio admin', description: 'Add a project to your private portfolio' }) %>
<header class="site-header wrap"><a class="wordmark" href="/admin">Portfolio<span class="accent">.</span> <span class="badge">Admin</span></a><div class="header-actions"><a class="nav-link" href="/admin/projects">Back to projects</a><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit">Sign out</button></form></div></header>
<main id="main" class="login-shell project-form-shell"><a class="back-link" href="/admin/projects">← All projects</a><p class="eyebrow">02 / Portfolio</p><h1 class="page-title">New project.</h1><p class="muted">Add the details that help people understand what you made.</p>
<% if (Object.keys(errors).length) { %><p class="notice error" role="alert">Please check the highlighted fields. Your project has not been saved.</p><% } %>
<form method="post" action="/admin/projects" class="stack editor-form" data-project-form>
<input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="field"><label for="title">Title</label><input id="title" name="title" value="<%= values.title %>" required aria-invalid="<%= Boolean(errors.title) %>" aria-describedby="title-error"><p id="title-error" class="field-error" data-error="title"><%= errors.title || '' %></p></div>
<div class="field"><label for="description">Description</label><p class="hint" id="description-hint">Describe the project in plain text. Separate paragraphs with a blank line.</p><textarea id="description" name="description" rows="6" required aria-invalid="<%= Boolean(errors.description) %>" aria-describedby="description-hint description-error"><%= values.description %></textarea><p id="description-error" class="field-error" data-error="description"><%= errors.description || '' %></p></div>
<div class="field"><label for="technologies">Technologies</label><p class="hint" id="technologies-hint">Add one technology per line. Repeated entries are removed.</p><textarea id="technologies" name="technologies" rows="4" required aria-invalid="<%= Boolean(errors.technologies) %>" aria-describedby="technologies-hint technologies-error"><%= values.technologies %></textarea><p id="technologies-error" class="field-error" data-error="technologies"><%= errors.technologies || '' %></p></div>
<div class="field"><label for="codeUrl">Code link <span class="optional">(optional)</span></label><input id="codeUrl" name="codeUrl" type="url" inputmode="url" autocomplete="url" placeholder="https://github.com/you/project" value="<%= values.codeUrl %>" aria-invalid="<%= Boolean(errors.codeUrl) %>" aria-describedby="codeUrl-hint codeUrl-error"><p id="codeUrl-hint" class="hint">A public HTTP or HTTPS link. Leave blank if you do not have one.</p><p id="codeUrl-error" class="field-error" data-error="codeUrl"><%= errors.codeUrl || '' %></p></div>
<div class="field"><label for="demoUrl">Demo link <span class="optional">(optional)</span></label><input id="demoUrl" name="demoUrl" type="url" inputmode="url" autocomplete="url" placeholder="https://your-project.example" value="<%= values.demoUrl %>" aria-invalid="<%= Boolean(errors.demoUrl) %>" aria-describedby="demoUrl-hint demoUrl-error"><p id="demoUrl-hint" class="hint">A public HTTP or HTTPS link to a demo. Leave blank if you do not have one.</p><p id="demoUrl-error" class="field-error" data-error="demoUrl"><%= errors.demoUrl || '' %></p></div>
<div class="save-row"><a class="text-link" href="/admin/projects">Cancel</a><button class="button" type="submit">Create project <span aria-hidden="true">↗</span></button></div>
</form></main><script type="module" src="/assets/project.js"></script>
</body></html>
