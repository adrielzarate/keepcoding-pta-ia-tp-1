<%- include('../partials/head', { title: project.title + ' — Projects', description: project.title }) %>
<header class="site-header wrap"><a class="wordmark" href="/admin">Portfolio<span class="accent">.</span> <span class="badge">Admin</span></a><div class="header-actions"><a class="nav-link" href="/admin/projects">Projects</a><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit">Sign out</button></form></div></header>
<main id="main" class="login-shell project-detail"><a class="back-link" href="/admin/projects">← Back to projects</a><p class="eyebrow">02 / Portfolio project</p><h1 class="page-title"><%= project.title %></h1><div class="project-description"><% for (const paragraph of project.description.split(/\n\s*\n/)) { %><p><%= paragraph %></p><% } %></div>
<div class="project-technologies"><p class="eyebrow">Built with</p><ul><% for (const technology of project.technologies) { %><li><%= technology %></li><% } %></ul></div>
<div class="project-links"><% if (project.codeUrl) { %><a class="text-link" href="<%= project.codeUrl %>" target="_blank" rel="noopener noreferrer">View code <span aria-hidden="true">↗</span></a><% } else { %><p class="hint">No code link provided.</p><% } %><% if (project.demoUrl) { %><a class="text-link" href="<%= project.demoUrl %>" target="_blank" rel="noopener noreferrer">View demo <span aria-hidden="true">↗</span></a><% } else { %><p class="hint">No demo link provided.</p><% } %></div>
</main></body></html>
