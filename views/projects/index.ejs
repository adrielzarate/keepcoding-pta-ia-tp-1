<%- include('../partials/head', { title: 'Projects — Portfolio admin', description: 'Manage your portfolio projects' }) %>
<header class="site-header wrap"><a class="wordmark" href="/admin">Portfolio<span class="accent">.</span> <span class="badge">Admin</span></a><div class="header-actions"><a class="nav-link" href="/admin">Presentation</a><a class="nav-link" href="/">View website ↗</a><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link-button" type="submit">Sign out</button></form></div></header>
<main id="main" class="admin-shell wrap"><aside class="admin-aside"><p class="eyebrow">Your workspace</p><a class="active-nav" href="/admin/projects" aria-current="page">Projects <span aria-hidden="true">↗</span></a><a class="side-nav" href="/admin">Presentation</a><p class="aside-note">Work that<br>speaks for itself.</p></aside>
<section class="editor" aria-labelledby="projects-title"><p class="eyebrow">02 / Portfolio</p><div class="section-heading"><div><h1 id="projects-title" class="page-title">Projects.</h1><p class="muted">A collection of things you have made.</p></div><a class="button" href="/admin/projects/new">New project <span aria-hidden="true">＋</span></a></div>
<% if (projects.length === 0) { %><div class="empty-state"><p class="eyebrow">Your work starts here</p><p>No projects yet</p><a class="text-link" href="/admin/projects/new">Create your first project <span aria-hidden="true">→</span></a></div><% } else { %>
<ol class="project-list"><% for (const project of projects) { %><li><a class="project-row" href="/admin/projects/<%= project.id %>"><span><span class="project-row-title"><%= project.title %></span><span class="project-row-meta"><%= project.technologies.join(' · ') %></span></span><span class="project-arrow" aria-hidden="true">↗</span></a></li><% } %></ol><% } %>
</section></main>
</body></html>
